# Bu dosyayı .env olarak kopyalayın ve kendi anahtarlarınızı girin.
# Ardından: export $(cat .env | xargs)  (ya da python-dotenv kullanın)

YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# İsteğe bağlı: kademeli kanıt getirme (native yetersizse). Boşsa Serper atlanır.
SERPER_API_KEY=your_serper_dev_api_key_here

# İsteğe bağlı: farklı bir HF NLI modeli kullanmak isterseniz
# NLI_MODEL=MoritzLaurer/mDeBERTa-v3-base-mnli-xnli

# Dashboard "Analiz et" izleme listesini tarar. CLI için:
# python run_pipeline.py --watchlist
